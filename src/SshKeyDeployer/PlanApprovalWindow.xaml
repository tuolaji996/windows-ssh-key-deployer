<Window x:Class="SshKeyDeployer.PlanApprovalWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="确认部署计划"
        Width="640"
        Height="620"
        MinWidth="540"
        MinHeight="460"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBrush}"
        Foreground="{DynamicResource TextBrush}">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="42" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Width="34" Height="34" CornerRadius="6"
                    Background="{DynamicResource WarningSurfaceBrush}"
                    HorizontalAlignment="Left" VerticalAlignment="Top">
                <TextBlock Text="&#xE9D9;" FontFamily="{StaticResource IconFont}" FontSize="17"
                           Foreground="{DynamicResource WarningBrush}"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <StackPanel Grid.Column="1">
                <TextBlock x:Name="PromptTitleText" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" />
                <TextBlock x:Name="PromptLeadText" Style="{StaticResource PageLeadStyle}" Margin="0,5,0,0" />
            </StackPanel>
        </Grid>

        <ScrollViewer Grid.Row="1" Margin="0,18,0,0" VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <TextBlock x:Name="ServerSectionText" Style="{StaticResource SectionTitleStyle}" FontSize="14" />
                <Border Margin="0,8,0,0" Padding="14"
                        Background="{DynamicResource SurfaceAltBrush}"
                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="5">
                    <Grid x:Name="ServerDetailsGrid">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" MinWidth="110" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                    </Grid>
                </Border>

                <TextBlock x:Name="ActionsSectionText" Style="{StaticResource SectionTitleStyle}" FontSize="14" Margin="0,16,0,0" />
                <StackPanel x:Name="ActionsPanel" Margin="0,8,0,0" />
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2" Margin="0,14,0,0" Padding="10"
                CornerRadius="5" Background="{DynamicResource WarningSurfaceBrush}">
            <TextBlock x:Name="NoteText" Foreground="{DynamicResource WarningBrush}"
                       FontSize="11" TextWrapping="Wrap" />
        </Border>

        <StackPanel Grid.Row="3" Margin="0,16,0,0" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="CancelButton" Style="{StaticResource SecondaryButton}" MinWidth="88"
                    IsCancel="True" IsDefault="True" Click="CancelButton_Click" />
            <Button x:Name="ApproveButton" Tag="&#xE73E;" Style="{StaticResource PrimaryButton}"
                    MinWidth="122" Margin="10,0,0,0"
                    Click="ApproveButton_Click" />
        </StackPanel>
    </Grid>
</Window>
