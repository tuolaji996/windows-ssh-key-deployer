<Window x:Class="SshKeyDeployer.HostKeyPromptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="确认服务器身份"
        Width="540"
        Height="360"
        MinWidth="500"
        MinHeight="340"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="42" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Width="34" Height="34" CornerRadius="6"
                    Background="{DynamicResource WarningSurfaceBrush}"
                    HorizontalAlignment="Left" VerticalAlignment="Top">
                <TextBlock Text="&#xE7BA;" FontFamily="{StaticResource IconFont}" FontSize="17"
                           Foreground="{DynamicResource WarningBrush}"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <StackPanel Grid.Column="1">
                <TextBlock Text="确认这台服务器的主机指纹" FontSize="18" FontWeight="SemiBold" />
                <TextBlock Text="首次连接前，请与服务器控制台中显示的指纹核对。"
                           Style="{StaticResource PageLeadStyle}" Margin="0,5,0,0" />
            </StackPanel>
        </Grid>

        <Border Grid.Row="1" Margin="0,20,0,0" Padding="14"
                Background="{DynamicResource SurfaceAltBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="5">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="82" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="服务器" Style="{StaticResource FieldLabelStyle}" Margin="0" />
                    <TextBlock x:Name="HostValueText" Grid.Column="1" FontWeight="SemiBold" TextWrapping="Wrap" />
                </Grid>
                <Grid Grid.Row="1" Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="82" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="算法" Style="{StaticResource FieldLabelStyle}" Margin="0" />
                    <TextBlock x:Name="AlgorithmValueText" Grid.Column="1" FontFamily="Cascadia Mono, Consolas" />
                </Grid>
                <Grid Grid.Row="2" Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="82" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="38" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="SHA256" Style="{StaticResource FieldLabelStyle}" Margin="0" />
                    <TextBox x:Name="FingerprintValueTextBox" Grid.Column="1" IsReadOnly="True"
                             BorderThickness="0" Background="Transparent" Padding="0"
                             FontFamily="Cascadia Mono, Consolas" FontSize="12" TextWrapping="Wrap" />
                    <Button Grid.Column="2" Tag="&#xE8C8;" Style="{StaticResource IconButtonStyle}"
                            ToolTip="复制指纹" AutomationProperties.Name="复制指纹"
                            Click="CopyFingerprintButton_Click" />
                </Grid>
            </Grid>
        </Border>

        <TextBlock Grid.Row="2" Margin="0,14,0,0"
                   Text="如果指纹与服务器控制台不一致，请选择取消。"
                   Foreground="{DynamicResource DangerBrush}" FontSize="12" />

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="取消" Style="{StaticResource SecondaryButton}" MinWidth="88"
                    IsCancel="True" Click="CancelButton_Click" />
            <Button Content="信任并继续" Tag="&#xE73E;" Style="{StaticResource PrimaryButton}"
                    MinWidth="122" Margin="10,0,0,0" IsDefault="True"
                    Click="ApproveButton_Click" />
        </StackPanel>
    </Grid>
</Window>
